  flex-direction: column;
  gap: 8px;
}

.widget .images:empty::before {
  content: 'Nessuna immagine: premi Aggiungi immagine per iniziare';
  padding: 22px 12px;
  border: 1px dashed var(--wb-border);
  border-radius: 12px;
  color: var(--wb-text-dim);
  font-size: 12px;
  text-align: center;
}

/* ---------- Image cards ---------- */
.widget .images .item {
  display: grid;
  grid-template-areas:
    'canvas name up down'
    'canvas toggle up down';
  grid-template-columns: 48px 1fr 28px 28px;
  grid-template-rows: auto 1fr;
  align-items: center;
  gap: 6px 10px;
  padding: 10px;
  border: 1px solid var(--wb-border);
  border-radius: 12px;
  background: var(--wb-surface);
  transition: border-color 0.2s, background-color 0.2s;
}

.widget .images .item:hover {
  border-color: var(--wb-border-accent);
  background: var(--wb-surface-hover);
}

.widget .images .item canvas {
  grid-area: canvas;
  width: 48px;
  height: 64px;
  border: 1px solid var(--wb-border);
  border-radius: 6px;
  background: repeating-conic-gradient(#2a2f3e 0% 25%, #1c2030 0% 50%) 50% / 10px 10px;
  image-rendering: pixelated;
  cursor: pointer;
  transition: transform 0.15s, border-color 0.15s;
}

.widget .images .item canvas:hover {
  border-color: var(--wb-accent);
  transform: scale(1.04);
}

.widget .images .item .name {
  display: block;
  grid-area: name;
  width: 100%;
  padding: 4px 2px;
  border: none;
  border-bottom: 1px solid var(--wb-border);
  border-radius: 0;
  background: transparent;
  color: var(--wb-text);
  font-size: 13px;
  font-weight: 600;
  cursor: text;
}

.widget .images .item .name:focus {
  outline: none;
  border-bottom-color: var(--wb-accent);
}

.widget .images .item .toggle {
  display: flex;
  grid-area: toggle;
  align-items: center;
  justify-content: flex-start;
  gap: 8px;
  padding: 0;
  border: none;
  background: none;
  color: var(--wb-text-dim);
  font-size: 12px;
  cursor: pointer;
  transition: color 0.2s;
}

.widget .images .item .toggle:hover {
  color: var(--wb-text);
}

.widget .images .item .up,
.widget .images .item .down {
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: stretch;
  padding: 0;
  border: none;
  border-radius: 6px;
  background: transparent;
  color: var(--wb-text-dim);
  font-size: 18px;
  cursor: pointer;
  transition: background-color 0.2s, color 0.2s;
}

.widget .images .item .up:hover:not(:disabled),
.widget .images .item .down:hover:not(:disabled) {
  background: var(--wb-surface-hover);
  color: var(--wb-text);
}

.widget .images .item .up:disabled,
.widget .images .item .down:disabled {
  opacity: 0.3;
  cursor: not-allowed;
}

.widget .images .item .up {
  grid-area: up;
}

.widget .images .item .down {
  grid-area: down;
}

/* ---------- Shared form controls (panel + image settings) ---------- */
.form {
  flex-grow: 1;
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: rgba(255, 255, 255, 0.22) transparent;
}

.form::-webkit-scrollbar {
  width: 8px;
}

.form::-webkit-scrollbar-thumb {
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.2);
}

.form button,
.form select,
.form input:not([type='checkbox']):not([type='range']) {
  padding: 9px 12px;
  border: 1px solid var(--wb-border);
  border-radius: 8px;
  background: var(--wb-surface);
  color: var(--wb-text);
  cursor: pointer;
  transition: background-color 0.2s, border-color 0.2s, box-shadow 0.2s, transform 0.1s;
}

.form select,
.form input:not([type='checkbox']):not([type='range']) {
  cursor: auto;
}

.form select {
  cursor: pointer;
}

.form option {
  background: var(--wb-bg-solid);
  color: var(--wb-text);
}

.form button:hover:not(:disabled),
.form select:hover,
.form input:not([type='checkbox']):not([type='range']):hover {
  border-color: var(--wb-border-accent);
  background-color: var(--wb-surface-hover);
}

.form button:active:not(:disabled) {
  transform: translateY(1px);
}

.form button:focus-visible,
.form select:focus-visible,
.form input:focus-visible {
  outline: 2px solid rgba(var(--wb-accent-rgb), 0.55);
  outline-offset: 1px;
}

.form button:disabled,
.form input:disabled {
  border-color: var(--wb-border);
  color: rgba(139, 149, 167, 0.55);
  cursor: not-allowed;
  opacity: 0.7;
}

.form input[type='checkbox'] {
  width: 16px;
  height: 16px;
  margin: 0;
  accent-color: var(--wb-accent);
  cursor: pointer;
}

.form label {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--wb-text);
}

.form label select {
  margin-left: auto;
  min-width: 150px;
}

/* Range slider: fill is driven by the --val custom property set from JS */
.form input[type='range'] {
  flex: 1;
  height: 18px;
  margin: 0 0 0 12px;
  padding: 0;
  border: none;
  background: transparent;
  appearance: none;
  cursor: ew-resize;
}

.form input[type='range']::-webkit-slider-runnable-track {
  height: 6px;
  border-radius: 3px;
  background: linear-gradient(to right, var(--wb-accent) var(--val, 50%), rgba(255, 255, 255, 0.14) var(--val, 50%));
}

.form input[type='range']::-moz-range-track {
  height: 6px;
  border-radius: 3px;
  background: linear-gradient(to right, var(--wb-accent) var(--val, 50%), rgba(255, 255, 255, 0.14) var(--val, 50%));
}

.form input[type='range']::-webkit-slider-thumb {
  width: 14px;
  height: 14px;
  margin-top: -4px;
  border: 2px solid var(--wb-accent);
  border-radius: 50%;
  background: #fff;
  appearance: none;
  box-shadow: 0 0 8px rgba(var(--wb-accent-rgb), 0.5);
}

.form input[type='range']::-moz-range-thumb {
  width: 10px;
  height: 10px;
  border: 2px solid var(--wb-accent);
  border-radius: 50%;
  background: #fff;
}

.form input[type='number'] {
  width: 90px;
  margin-left: auto;
  text-align: right;
}

/* ---------- Progress bar ---------- */
.progress {
  position: relative;
  flex: none;
  height: 26px;
  overflow: hidden;
  border: 1px solid var(--wb-border);
  border-radius: 999px;
  background: rgba(0, 0, 0, 0.4);
}

.progress div {
  position: absolute;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, rgba(var(--wb-accent-rgb), 0.45), rgba(var(--wb-accent-rgb), 0.85));
  box-shadow: 0 0 12px rgba(var(--wb-accent-rgb), 0.5);
  transform-origin: left;
  transition: transform 0.3s ease;
}

.progress span {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 0 10px;
  overflow: hidden;
  color: #fff;
  font-size: 11px;
  font-weight: 600;
  white-space: nowrap;
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.75);
}

/* ---------- Color list (drag to reorder) ---------- */
.form .colors {
  position: relative;
  display: block;
  flex: none;
  width: 100%;
  margin: 0;
  overflow: hidden;
  border: 1px solid var(--wb-border);
  border-radius: 10px;
}

.form .colors > button {
  position: absolute;
  left: 0;
  z-index: 1;
  display: block;
  width: 100%;
  height: 20px;
  padding: 0 8px;
  border: none;
  border-radius: 0;
  color: var(--wb-text-invert);
  font-size: 12px;
  line-height: 20px;
  cursor: ns-resize;
  transition: top 0.5s ease, filter 0.15s;
}

.form .colors > button.dark {
  color: #fff;
}

.form .colors > button:hover:not(:disabled) {
  background-color: inherit;
  filter: brightness(0.75);
}

.form .colors > button * {
  float: left;
  font-size: 12px;
}

.form .colors > button .percent {
  float: right;
  font-size: 11px;
}

.form .colors > button > div {
  margin-right: 6px;
}

.form .colors > button > button {
  width: 24px;
  height: 100%;
  margin-right: 6px;
  padding: 0;
  border: 1px solid rgba(0, 0, 0, 0.45);
  border-radius: 0;
}

.form .colors > button.color-disabled {
  opacity: 0.45;
  filter: grayscale(0.7);
}

.form .colors > button.dragging {
  z-index: 100;
  outline: 2px solid #fff;
  outline-offset: -2px;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.5);
}

/* ---------- Image overlay on the map ---------- */
.image {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 9;
  color-scheme: dark;
}

.image * {
  font-family: var(--wb-font);
  font-size: 13px;
}

.image canvas {
  width: 100%;
  box-shadow: inset 0 0 0 2px var(--wb-accent), 0 0 18px rgba(var(--wb-accent-rgb), 0.22);
  image-rendering: pixelated;
  cursor: all-scroll;
}

.topbar {
  position: absolute;
  top: -26px;
  left: 0;
  display: flex;
  align-items: stretch;
  width: 100%;
  min-width: 256px;
  height: 26px;
  overflow: hidden;
  border: 1px solid var(--wb-border-accent);
  border-radius: 8px 8px 0 0;
  background: rgba(14, 17, 28, 0.92);
  backdrop-filter: blur(8px);
  color: var(--wb-text);
  cursor: all-scroll;
}

.topbar .name {
  flex: 1;
  min-width: 0;
  height: 100%;
  padding: 0 8px;
  border: none;
  background: transparent;
  color: var(--wb-text);
  font-size: 12px;
  font-weight: 600;
}

.topbar .name:focus {
  outline: none;
  background: rgba(255, 255, 255, 0.06);
}

.topbar button {
  display: flex;
  flex: none;
  justify-content: center;
  align-items: center;
  width: 26px;
  height: 100%;
  padding: 0;
  border: none;
  border-left: 1px solid var(--wb-border);
  background: transparent;
  font-size: 12px;
  cursor: pointer;
  transition: background-color 0.15s;
}

.topbar button:hover {
  background: rgba(var(--wb-accent-rgb), 0.18);
}

/* ---------- Resize handles ---------- */
.resize {
  position: absolute;
  width: calc(100% - var(--wb-resize) - var(--wb-resize));
  height: calc(100% - var(--wb-resize) - var(--wb-resize));
  transition: background-color 0.15s;
}

.resize:hover {
  background: rgba(var(--wb-accent-rgb), 0.3);
}

.resize.n {
  top: 0;
  left: var(--wb-resize);
  height: var(--wb-resize);
  cursor: n-resize;
}

.resize.e {
  top: var(--wb-resize);
  right: 0;
  width: var(--wb-resize);
  cursor: e-resize;
}

.resize.s {
  bottom: 0;
  left: var(--wb-resize);
  height: var(--wb-resize);
  cursor: s-resize;
}

.resize.w {
  top: var(--wb-resize);
  left: 0;
  width: var(--wb-resize);
  cursor: w-resize;
}

/* ---------- Image settings dialog ---------- */
dialog.form {
  width: clamp(320px, 60vw, 540px);
  height: min(72vh, 680px);
  margin: auto;
  padding: 18px;
  border: 1px solid var(--wb-border);
  border-radius: 16px;
  background: var(--wb-bg-solid);
