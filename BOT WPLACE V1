}

/* ---------- Utility ---------- */
.p {
  padding: 0 8px;
}

.hidden {
  display: none !important;
}

.no-pointer-events {
  height: 1px;
  pointer-events: none;
}

@media (prefers-reduced-motion: reduce) {
  .widget *,
  .image *,
  dialog.form * {
    transition: none !important;
  }
}
