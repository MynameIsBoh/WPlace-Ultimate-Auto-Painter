// src/widget.ts
class Widget extends Base2 {
  bot;
  element = document.createElement("div");
  get status() {
    return this.$status.innerHTML;
  }
  set status(value) {
    this.$status.innerHTML = value;
  }
  get open() {
    return containsClass(this.element, "open");
  }
  set open(value) {
    if (value)
      addClass(this.element, "open");
    else
      removeClass(this.element, "open");
  }
  $openBotSettings;
  $botSettingsPanel;
  $drawThreshold;
  $settings;
  $status;
  $minimize;
  $topbar;
  $title;
  $draw;
  $addImage;
  $strategy;
  $progressLine;
  $progressText;
  $images;
  $openButton;
  $autoDraw;
  $closeModal;
  $exportBot;
  $importBot;
  constructor(bot) {
    super();
    this.bot = bot;
    addClass(this.element, "widget");
    this.element.innerHTML = obfucsateHTML(widget_default);
    document.body.append(this.element);
    this.populateElementsWithSelector(this.element, {
      $openButton: ".open-button",
      $openBotSettings: ".open-bot-settings",
      $botSettingsPanel: ".bot-settings-panel",
      $drawThreshold: ".draw-threshold",
      $closeModal: ".close-modal",
      $settings: ".form",
      $status: ".status",
      $minimize: ".minimize",
      $topbar: ".topbar",
      $title: ".title",
      $draw: ".draw",
      $addImage: ".add-image",
      $strategy: ".strategy",
      $progressLine: ".progress div",
      $progressText: ".progress span",
      $rechargeEta: ".recharge-eta",
      $images: ".images",
      $autoDraw: ".auto-draw",
      $autoUpgradeCooldown: ".auto-upgrade-cooldown",
      $autoUpgradeStorage: ".auto-upgrade-storage",
      $testUpgradeBtn: ".test-upgrade-btn",
      $exportBot: ".export-bot",
      $importBot: ".import-bot"
    });
    let isBtnDragging = false;
    let btnStartX = 0, btnStartY = 0, btnInitialLeft = 0, btnInitialTop = 0;

    this.$openButton.addEventListener("mousedown", (e) => {
      isBtnDragging = false;
      btnStartX = e.clientX;
      btnStartY = e.clientY;
      const rect = this.$openButton.getBoundingClientRect();
      btnInitialLeft = rect.left;
      btnInitialTop = rect.top;
      e.preventDefault();
    });

    document.addEventListener("mousemove", (e) => {
      if (btnStartX !== 0 && (Math.abs(e.clientX - btnStartX) > 5 || Math.abs(e.clientY - btnStartY) > 5)) {
        isBtnDragging = true;
      }
      if (!isBtnDragging || btnStartX === 0) return;

      const dx = e.clientX - btnStartX;
      const dy = e.clientY - btnStartY;
      this.$openButton.style.left = `${btnInitialLeft + dx}px`;
      this.$openButton.style.top = `${btnInitialTop + dy}px`;
      this.$openButton.style.right = 'auto';
      this.$openButton.style.bottom = 'auto';
    });

    document.addEventListener("mouseup", () => {
      btnStartX = 0;
      setTimeout(() => isBtnDragging = false, 0);
    });

    this.$openButton.addEventListener("click", (e) => {
      if (isBtnDragging) {
        e.preventDefault();
        e.stopPropagation();
        return;
      }
      if (!this.open) {
        const btnRect = this.$openButton.getBoundingClientRect();
        modalContainer.style.left = `${btnRect.left}px`;
        modalContainer.style.top = `${btnRect.top}px`;
      }
      this.open = !this.open;
    });
    this.$closeModal.addEventListener("click", () => {
      const modalRect = modalContainer.getBoundingClientRect();
      this.$openButton.style.left = `${modalRect.left}px`;
      this.$openButton.style.top = `${modalRect.top}px`;
      this.open = false;
    });
    this.$minimize.addEventListener("click", () => this.minimize());

    // Drag Logic
    const modalContainer = querySelector(this.element, ".modal-container");
    const header = querySelector(this.element, ".header");
    let isDragging = false;
    let startX = 0, startY = 0, initialLeft = 0, initialTop = 0;

    header.addEventListener("mousedown", (e) => {
      if (e.target.closest("button, input")) return;
      isDragging = true;
      startX = e.clientX;
      startY = e.clientY;
      const rect = modalContainer.getBoundingClientRect();
      initialLeft = rect.left;
      initialTop = rect.top;
    });

    document.addEventListener("mousemove", (e) => {
      if (!isDragging) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      modalContainer.style.left = `${initialLeft + dx}px`;
      modalContainer.style.top = `${initialTop + dy}px`;
    });

    document.addEventListener("mouseup", () => {
      isDragging = false;
    });

    this.$draw.addEventListener("click", () => this.bot.draw());
    this.$addImage.addEventListener("click", () => this.addImage());
    this.$strategy.addEventListener("change", () => {
      this.bot.strategy = this.$strategy.value;
    });
    this.$autoDraw.addEventListener("click", () => this.bot.autoDraw());

    this.$openBotSettings.addEventListener("click", () => {
      this.$botSettingsPanel.style.display = this.$botSettingsPanel.style.display === "none" ? "flex" : "none";
    });
    this.$drawThreshold.addEventListener("change", () => {
      this.bot.drawThreshold = Number(this.$drawThreshold.value) || 0;
      save(this.bot);
    });
    this.$autoUpgradeCooldown.addEventListener("change", () => {
      this.bot.autoUpgradeCooldown = this.$autoUpgradeCooldown.checked;
      save(this.bot);
    });
    this.$autoUpgradeStorage.addEventListener("change", () => {
      this.bot.autoUpgradeStorage = this.$autoUpgradeStorage.checked;
      save(this.bot);
    });
    this.$testUpgradeBtn.addEventListener("click", () => {
      if (this.bot && !this.bot.isUpgrading) {
        this.bot.performAutoUpgrade(true);
      }
    });

    this.$exportBot.addEventListener("click", async () => {
      const a = document.createElement("a");
      document.body.append(a);
      a.href = URL.createObjectURL(new Blob([JSON.stringify(await this.bot.toJSON())], {
        type: "application/json"
      }));
      a.download = `Wplace-Bot-Setup.wbot`;
      a.click();
      URL.revokeObjectURL(a.href);
      a.remove();
    });

    this.$importBot.addEventListener("click", () => {
      const input = document.createElement("input");
      input.type = "file";
      input.accept = ".wbot";
      input.click();
      input.addEventListener("change", async () => {
        const file = input.files?.[0];
        if (file) {
          try {
            const json = JSON.parse(await file.text());
            const migrated = migrate(json);
            await idbSet(KEY_NAME, migrated);
            document.location.reload();
          } catch (e) {
            alert("Errore durante l'importazione del setup!");
          }
        }
      });
    });

    this.update();

    // Timer per l'ETA della ricarica
    setInterval(() => {
      if (this.bot.me) {
